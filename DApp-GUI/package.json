{
  "name": "airflow-multisend-dapp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "compile": "node scripts/compile.js",
    "compile:dao": "node scripts/compile-dao.js",
    "compile:test-token": "node scripts/compile-test-token.js",
    "compile:all": "npm run compile && npm run compile:dao && npm run compile:test-token",
    "predev": "npm run compile:all",
    "dev": "vite --configLoader runner --host 127.0.0.1",
    "prebuild": "npm run compile:all",
    "build": "vite build --configLoader runner",
    "preview": "vite preview --configLoader runner --host 127.0.0.1"
  },
  "dependencies": {
    "ethers": "^6.15.0",
    "solc": "^0.8.30"
  },
  "devDependencies": {
    "vite": "^7.0.5"
  }
}
